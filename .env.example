# SMGD DriveLog – exempel på miljövariabler. Kopiera till .env och fyll i.
# Lägg ALDRIG riktiga hemligheter i versionshanteringen.

# Domän som Caddy ska hämta certifikat för (t.ex. journal.smgd.se). "localhost" för lokal körning.
DRIVELOG_DOMAIN=localhost

# Publik adress till webbappen. Används i OAuth-redirects (Volvo, Microsoft) och i notislänkar.
DRIVELOG_BASE_URL=https://localhost

# Databaslösenord (PostgreSQL). Skapa t.ex. med: openssl rand -base64 32
POSTGRES_PASSWORD=

# Slumpad applikationshemlighet, minst 32 tecken: openssl rand -hex 32
DRIVELOG_SECRET_KEY=

# Krypteringsnyckel för lagrade OAuth-tokens och API-nycklar (Fernet).
# Skapa med: docker compose run --rm api python -m app.cli generate-key
# Flera nycklar kan anges kommaseparerat vid nyckelrotation (den första krypterar).
DRIVELOG_ENCRYPTION_KEYS=

# Standardtidszon för visning och gruppering (kan ändras per användare under Inställningar).
DRIVELOG_TIMEZONE=Europe/Stockholm

# Valfritt: skapa första administratören automatiskt (annars sker det i webbläsaren vid första besöket).
# DRIVELOG_FIRST_ADMIN_EMAIL=
# DRIVELOG_FIRST_ADMIN_PASSWORD=

# Valfritt
# DRIVELOG_LOG_LEVEL=INFO
# DRIVELOG_MAX_UPLOAD_BYTES=10485760
# WORKER_CONCURRENCY=2
# Vilka proxyadresser som får sätta X-Forwarded-*-huvuden (standard "*": API:t nås bara via proxyn).
# FORWARDED_ALLOW_IPS=*

# Externa integrationer (Volvo, Microsoft, Home Assistant, AI) konfigureras i webbgränssnittet
# under Integrationer. Uppgifterna lagras krypterade i databasen – inte här.
