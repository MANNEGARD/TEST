# SMGD Transkribering – inställningar. Kopiera till .env och fyll i.

# Adressen tjänsten nås på (används i inbjudningslänkar och för säkra cookies).
TRANSCRIBE_PUBLIC_URL=https://transcribe.smgd.se

# Bara med docker-compose.fristaende.yml (egen Caddy, ingen DriveLog):
TRANSCRIBE_DOMAIN=transcribe.smgd.se

# --- Live-text och talaruppdelning: Deepgram ---------------------------------------------
# Skapa ett gratiskonto på https://console.deepgram.com (200 USD i startkredit, räcker till
# ungefär 200 timmar svenska). API Keys → Create a New API Key (rollen "Member" räcker).
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=sv

# --- Slutversionens text: Whisper large-v3 ----------------------------------------------
# Standard är Groqs gratisnivå: konto på https://console.groq.com → API Keys.
# (Ungefär 2 h ljud per timme och 8 h per dygn gratis; tjänsten väntar automatiskt ut gränsen.)
WHISPER_API_KEY=
# Byt till en egen OpenAI-kompatibel server, t.ex. KB-Whisper på en dator hemma:
# WHISPER_API_URL=https://api.groq.com/openai/v1
# WHISPER_MODEL=whisper-large-v3
# WHISPER_LANGUAGE=sv
# WHISPER_CHUNK_SECONDS=600

# --- Övrigt ------------------------------------------------------------------------------
# Längsta inspelning i minuter och antal samtidiga inspelningar totalt.
# TRANSCRIBE_MAX_RECORDING_MINUTES=240
# TRANSCRIBE_MAX_RECORDINGS=4
# Behåll okomprimerat originalljud (~115 MB/h) efter slutversionen. Standard: false.
# TRANSCRIBE_KEEP_WAV=false
# Hur länge man är inloggad (dagar).
# TRANSCRIBE_SESSION_DAYS=30
# TRANSCRIBE_LOG_LEVEL=info
